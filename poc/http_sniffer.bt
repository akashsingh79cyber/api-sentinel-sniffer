tracepoint:syscalls:sys_enter_sendto
{
    $b = str(args->buff, 64);
    if (strncmp($b, "GET ", 4) == 0 || strncmp($b, "POST", 4) == 0 ||
        strncmp($b, "PUT ", 4) == 0 || strncmp($b, "DELE", 4) == 0 ||
        strncmp($b, "PATC", 4) == 0) {
        printf("[pid=%d comm=%s] %s\n", pid, comm, $b);
    }
}
